<?xml version="1.0" encoding="utf-8"?>
<!--
  Debug builds only. This file shadows the release policy so a test device can
  reach a development server over plain HTTP on the college LAN. It is never
  packaged into a release APK.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system"/>
        </trust-anchors>
    </base-config>
</network-security-config>
