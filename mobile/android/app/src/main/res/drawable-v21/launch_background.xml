<?xml version="1.0" encoding="utf-8"?>
<!--
  The window behind the app while the Flutter engine starts. It is painted the
  same off-white the app's light theme uses (and the dark surface under a night
  theme, via values-night), so the first frame does not arrive as a colour
  change.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/launch_background" />
</layer-list>
