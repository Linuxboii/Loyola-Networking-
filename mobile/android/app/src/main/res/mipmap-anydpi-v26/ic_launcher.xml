<?xml version="1.0" encoding="utf-8"?>
<!--
  Adaptive icon. The launcher masks these two layers into whatever shape the
  device theme uses, so the monogram is drawn small and centred (see
  tool/make_launcher_icons.py) and the brand colour fills the plate behind it.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_background"/>
    <foreground android:drawable="@mipmap/ic_launcher_foreground"/>
    <monochrome android:drawable="@mipmap/ic_launcher_foreground"/>
</adaptive-icon>
