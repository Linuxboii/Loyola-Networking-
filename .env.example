# Copy to .env and fill in. Every setting is optional in development — the
# defaults in app/config.py boot a working server — but production must set
# LOYOLA_SECRET_KEY and LOYOLA_MEDIA_KEY to real values.

LOYOLA_DEBUG=true
LOYOLA_BASE_URL=http://127.0.0.1:8011
LOYOLA_DATABASE_URL=postgresql+asyncpg://loyola_user:loyola@127.0.0.1:5433/loyola_db

# Signs session cookies and media URLs. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
LOYOLA_SECRET_KEY=dev-only-insecure-secret-change-me

# Fernet key encrypting ID-card artefacts at rest. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
LOYOLA_MEDIA_KEY=

# Background jobs (reputation settling, artefact purging, digests).
LOYOLA_ENABLE_SCHEDULER=true
